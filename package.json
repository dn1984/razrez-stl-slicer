{
  "name": "razrez-stl-slicer",
  "private": false,
  "version": "1.0.0",
  "type": "module",
  "description": "Разрез — офлайн STL slicer with interlocking joints for 3D printing",
  "keywords": ["stl", "slicer", "3d-printing", "mesh", "manifold", "threejs", "offline"],
  "license": "MIT",
  "scripts": {
    "dev": "vite",
