    "test:watch": "vitest",
    "test:e2e": "node tests/e2e/run.mjs"
  },
  "dependencies": {
    "manifold-3d": "3.5.5",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@types/three": "^0.187.0",
    "playwright-core": "^1.56.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^3.2.4"
  }
}
